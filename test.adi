@import stdio;
@import string;

print("--- Testing AdiLang String Module v0.14.2 ---");

let text = "Hello, AdiLang World!";

print(string.length(text));
print(string.toUpper("hello world"));
print(string.contains(text, "AdiLang"));
print(string.contains(text, "Python"));
print(string.substr(text, 7, 7));