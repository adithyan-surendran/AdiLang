@import stdio;
@import fs;

print("--- Testing AdiLang v0.17.0 File I/O Streams ---");

let filename = "test_output.txt";

// Write initial content
fs.write(filename, "Hello from AdiLang v0.17.0!\n");
print("File written successfully.");

// Append content
fs.append(filename, "Appending an extra line to the stream.\n");
print("Content appended successfully.");

// Check existence and read back
if (fs.exists(filename)) {
    print("File contents read:");
    print(fs.read(filename));
} else {
    print("Error: File does not exist.");
}

print("--- File I/O test passed successfully! ---");