// Test basic math and printing
print (10 + 20 * 2);

// Test variables and assignment
let message = "Hello from AdiLang VM!";
print (message);

let counter = 0;
while (counter < 3) {
    print (counter);
    counter = counter + 1;
}

// Test functions and return values
fn add(a, b) {
    return a + b;
}
print (add(15, 27));