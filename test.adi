// Test 1: Basic nested function scoping and upvalue capture
fn makeCounter() {
    let count = 0;
    fn counter() {
        count = count + 1;
        return count;
    }
    return counter;
}

let c = makeCounter();
print (c()); // Expected: 1
print (c()); // Expected: 2
print (c()); // Expected: 3

// Test 2: Independent closure instances (each gets its own upvalue storage)
fn makeAdder(base) {
    fn add(n) {
        return base + n;
    }
    return add;
}

let addFive = makeAdder(5);
let addTen = makeAdder(10);

print (addFive(2)); // Expected: 7
print (addTen(2));  // Expected: 12