@import stdio;
@import os;

print("--- Testing AdiLang OS Module v0.14.3 ---");

// Check an environment variable
let user = os.getenv("USER");
print("Current User:");
print(user);

// Check if a file exists
let hasConfig = os.exists("config.adi");
print("Config exists:");
print(hasConfig);

// Run a quick shell command
let exitCode = os.system("echo 'Hello from OS shell!'");
print("Command exit code:");
print(exitCode);