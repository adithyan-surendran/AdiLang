@import stdio;
@import time;

print("--- Testing AdiLang Time Module v0.14.4 ---");

let start = time.now();
print("Start epoch timestamp:");
print(start);

print("Sleeping for 1 second...");
time.sleep(1.0);

let end = time.now();
print("End epoch timestamp:");
print(end);

let elapsed = end - start;
print("Elapsed time (seconds):");
print(elapsed);